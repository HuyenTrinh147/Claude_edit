.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/

# bí mật
.env
secrets/
*client_secret*.json
*service_account*.json
gdrive_token.json

# dự án chứa video gốc & video xuất — rất nặng, không đưa lên git
projects/*
!projects/.gitkeep

# bộ SFX nhập bằng `vedit sfx add`: chỉ commit chỉ mục (nguồn + danh sách), không commit file âm thanh
assets/sfx/**/*
!assets/sfx/*/
!assets/sfx/*/index.json

# tài nguyên media của bạn (nhạc, font, logo) — bỏ dòng dưới nếu muốn commit
assets/**/*.mp3
assets/**/*.wav
assets/**/*.m4a

# video đầu vào
inbox/*
!inbox/README.md

# repo / video tham khảo mà Agent 1 tải về để học
research/
