# Sao chép thành .env rồi điền giá trị.

# --- Claude API (bắt buộc cho 3 agent; lệnh analyze/render/validate không cần) ---
ANTHROPIC_API_KEY=sk-ant-...

# Model & mức "effort" (low | medium | high | xhigh | max) cho từng agent
VEDIT_MODEL=claude-opus-5-5
VEDIT_EFFORT_RESEARCH=medium
VEDIT_EFFORT_SCRIPT=high
VEDIT_EFFORT_EDIT=medium
VEDIT_MAX_TOKENS=64000
# 1 = khi Claude từ chối một lượt vì bộ lọc an toàn, API tự chạy lại lượt đó trên model dự phòng
VEDIT_FALLBACKS=1

# Ngôn ngữ kịch bản / ghi chú / nhận dạng giọng nói
VEDIT_LANG=vi
# Font cho chữ & phụ đề (cần hỗ trợ tiếng Việt). Có thể thả file .ttf vào assets/fonts/
VEDIT_FONT=Inter
# faster-whisper: tiny | base | small | medium | large-v3
VEDIT_WHISPER_MODEL=small

# Thư mục (mặc định nằm trong thư mục hiện tại)
# VEDIT_HOME=/duong/dan/den/claude_edit
# VEDIT_KNOWLEDGE_DIR=./knowledge
# VEDIT_PROJECTS_DIR=./projects
# VEDIT_ASSETS_DIR=./assets

# --- GitHub (tuỳ chọn: tăng giới hạn tìm kiếm cho Agent 1) ---
# GITHUB_TOKEN=ghp_...

# --- Google Drive (tuỳ chọn) ---
# Cách 1 (khuyên dùng cho Gmail cá nhân): OAuth client loại "Desktop app"
# GOOGLE_OAUTH_CLIENT_FILE=./secrets/client_secret.json
# GOOGLE_TOKEN_FILE=~/.config/vedit/gdrive_token.json
# Cách 2: service account + thư mục trong Shared Drive đã chia sẻ cho service account
# GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/service_account.json
# GOOGLE_DRIVE_PARENT_ID=<id thư mục cha>
# Tên thư mục gốc tạo trong My Drive (khi không đặt GOOGLE_DRIVE_PARENT_ID)
GOOGLE_DRIVE_ROOT_NAME=vedit
